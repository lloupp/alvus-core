{
  "listen": "127.0.0.1:3000",
  "request_body_limit_bytes": 67108864,
  "request_timeout": "180s",
  "circuit_breaker": {
    "failure_threshold": 3,
    "cooldown": "60s"
  },
  "cache": {
    "responses": {
      "enabled": false,
      "ttl": "1h",
      "max_entries": 256,
      "max_body_bytes": 1048576,
      "max_bytes": 67108864,
      "provider_kinds": [
        "nvidia"
      ]
    }
  },
  "providers": {
    "nvidia": {
      "kind": "nvidia",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEYS"
    }
  },
  "models": {
    "glm53": {
      "provider": "nvidia",
      "upstream_model": "z-ai/glm-5.3",
      "params": {
        "reasoning_effort": "max",
        "chat_template_kwargs": {
          "clear_thinking": true
        }
      },
      "attempt_timeout": "90s"
    },
    "kimi_k3": {
      "provider": "nvidia",
      "upstream_model": "moonshotai/kimi-k3",
      "params": {
        "reasoning_effort": "max"
      },
      "attempt_timeout": "120s"
    },
    "nemotron_ultra": {
      "provider": "nvidia",
      "upstream_model": "nvidia/nemotron-3-ultra-550b-a55b",
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "attempt_timeout": "60s"
    },
    "nemotron_super": {
      "provider": "nvidia",
      "upstream_model": "nvidia/nemotron-3-super-120b-a12b",
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "attempt_timeout": "45s"
    },
    "glm53_flash": {
      "provider": "nvidia",
      "upstream_model": "z-ai/glm-5.3-flash",
      "params": {
        "reasoning_effort": "low",
        "chat_template_kwargs": {
          "clear_thinking": true
        }
      },
      "attempt_timeout": "45s"
    },
    "nemotron_lightning": {
      "provider": "nvidia",
      "upstream_model": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "attempt_timeout": "60s"
    }
  },
  "routes": {
    "quality": [
      "kimi_k3",
      "glm53",
      "nemotron_ultra",
      "nemotron_super",
      "nemotron_lightning"
    ],
    "coding": [
      "nemotron_ultra",
      "nemotron_super"
    ],
    "reasoning": [
      "nemotron_super",
      "nemotron_ultra"
    ],
    "fast": [
      "nemotron_super",
      "nemotron_ultra"
    ],
    "vision": [
      "kimi_k3",
      "glm53_flash"
    ],
    "auto": [
      "nemotron_super",
      "nemotron_ultra"
    ],
    "default": [
      "nemotron_super",
      "nemotron_ultra"
    ]
  }
}
