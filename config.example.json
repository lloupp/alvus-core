{
  "listen": "127.0.0.1:3000",
  "request_body_limit_bytes": 67108864,
  "request_timeout": "300s",
  "circuit_breaker": {
    "failure_threshold": 3,
    "cooldown": "60s"
  },
  "providers": {
    "nvidia": {
      "kind": "nvidia",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEYS"
    }
  },
  "models": {
    "glm53": {
      "provider": "nvidia",
      "upstream_model": "z-ai/glm-5.3",
      "params": {
        "reasoning_effort": "max",
        "chat_template_kwargs": {
          "clear_thinking": true
        }
      }
    },
    "kimi_k3": {
      "provider": "nvidia",
      "upstream_model": "moonshotai/kimi-k3",
      "params": {
        "reasoning_effort": "max"
      }
    },
    "nemotron_ultra": {
      "provider": "nvidia",
      "upstream_model": "nvidia/nemotron-3-ultra-550b-a55b",
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      }
    },
    "nemotron_super": {
      "provider": "nvidia",
      "upstream_model": "nvidia/nemotron-3-super-120b-a12b",
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      }
    },
    "glm53_flash": {
      "provider": "nvidia",
      "upstream_model": "z-ai/glm-5.3-flash",
      "params": {
        "reasoning_effort": "low",
        "chat_template_kwargs": {
          "clear_thinking": true
        }
      }
    },
    "nemotron_lightning": {
      "provider": "nvidia",
      "upstream_model": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "params": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    }
  },
  "routes": {
    "quality": [
      "kimi_k3",
      "glm53",
      "nemotron_ultra",
      "nemotron_super",
      "nemotron_lightning"
    ],
    "coding": [
      "kimi_k3",
      "glm53",
      "nemotron_ultra",
      "nemotron_super",
      "nemotron_lightning"
    ],
    "reasoning": [
      "glm53",
      "kimi_k3",
      "nemotron_super",
      "nemotron_ultra",
      "nemotron_lightning"
    ],
    "fast": [
      "glm53",
      "nemotron_super",
      "nemotron_ultra",
      "nemotron_lightning"
    ],
    "vision": [
      "kimi_k3",
      "glm53_flash"
    ],
    "auto": [
      "glm53",
      "kimi_k3",
      "nemotron_super",
      "nemotron_ultra",
      "nemotron_lightning"
    ],
    "default": [
      "glm53",
      "kimi_k3",
      "nemotron_super",
      "nemotron_ultra",
      "nemotron_lightning"
    ]
  }
}
